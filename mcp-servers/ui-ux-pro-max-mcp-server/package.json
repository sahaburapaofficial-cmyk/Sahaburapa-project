{
  "name": "ui-ux-pro-max-mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server for the UI UX Pro Max design database: design systems, styles, palettes, font pairings, UX guidelines and stack tips",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ui-ux-pro-max-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
